                "video_id"
            ],
            "properties": {
                "parent_id": {
                    "type": "string"
                },
                "text": {
                    "type": "string",
                    "maxLength": 500,
                    "minLength": 1
                },
                "user_id": {
                    "type": "string"
                },
                "video_id": {
                    "type": "string"
                }
            }
