{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "user-service": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "auth-service": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "admin-user-service": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/admin/api/users/{**catch-all}"
        }
      },
      "content-service": {
        "ClusterId": "content-cluster",
        "Match": {
          "Path": "/api/videos/{**catch-all}"
        }
      },
      "stream-service": {
        "ClusterId": "content-cluster",
        "Match": {
          "Path": "/api/videos/stream/{**catch-all}"
        }
      },
      "admin-content-service": {
        "ClusterId": "content-cluster",
        "Match": {
          "Path": "/admin/api/videos/{**catch-all}"
        }
      },
      "social-likes": {
        "ClusterId": "social-cluster",
        "Match": {
          "Path": "/api/likes/{**catch-all}"
        }
      },
      "social-comments": {
        "ClusterId": "social-cluster",
        "Match": {
          "Path": "/api/comments/{**catch-all}"
        }
      },
      "social-views": {
        "ClusterId": "social-cluster",
        "Match": {
          "Path": "/api/views/{**catch-all}"
        }
      },
      "social-video-likes": {
        "ClusterId": "social-cluster",
        "Match": {
          "Path": "/api/videos/{videoId}/likes/{**catch-all}"
        }
      },
      "social-video-comments": {
        "ClusterId": "social-cluster",
        "Match": {
          "Path": "/api/videos/{videoId}/comments/{**catch-all}"
        }
      },
      "social-video-views": {
        "ClusterId": "social-cluster",
        "Match": {
          "Path": "/api/videos/{videoId}/views/{**catch-all}"
        }
      },
      "social-interests": {
        "ClusterId": "social-cluster",
        "Match": {
          "Path": "/api/users/{userId}/interests/{**catch-all}"
        }
      },
      "feed-service": {
        "ClusterId": "feed-cluster",
        "Match": {
          "Path": "/api/feed/{**catch-all}"
        }
      },
      "search-service": {
        "ClusterId": "search-cluster",
        "Match": {
          "Path": "/api/search/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "user": {
            "Address": "http://user-service:8080/"
          }
        },
        "HttpClient": {
          "Timeout": "00:00:30"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "content-cluster": {
        "Destinations": {
          "content": {
            "Address": "http://content-service:8080/"
          }
        },
        "HttpClient": {
          "Timeout": "00:01:00"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "social-cluster": {
        "Destinations": {
          "social": {
            "Address": "http://social-service:8080/"
          }
        },
        "HttpClient": {
          "Timeout": "00:00:30"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "feed-cluster": {
        "Destinations": {
          "feed": {
            "Address": "http://feed-service:8080/"
          }
        },
        "HttpClient": {
          "Timeout": "00:00:30"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "search-cluster": {
        "Destinations": {
          "search": {
            "Address": "http://search-service:8000/"
          }
        },
        "HttpClient": {
          "Timeout": "00:00:30"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      }
    }
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}"
  }
}